<?xml version="1.0" encoding="utf-8"?>
<!--
  受付端末は来店客の氏名・予約情報を扱う。端末のバックアップや
  端末間転送でそれらが店舗外へ出ないよう、どちらも許可しない
  (PRD 13 / 16 Zero Trust)。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
