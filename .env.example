# 開発用の設定例。
#
# 本番では Secret Manager から注入する (PRD 13-4)。
# APIシークレット・署名鍵・証明書を開発者PCへ恒久保存しないこと。
# このファイル自体に本番の値を書かない。.env は .gitignore 済み。

# ---------------------------------------------------------------------------
# サーバー
# ---------------------------------------------------------------------------
# Cloud Run は PORT を注入するので、本番では設定不要
PORT=3000

# ---------------------------------------------------------------------------
# データストア
# ---------------------------------------------------------------------------
# 未設定なら in-memory（ローカル開発・テスト）。共有環境・本番は firestore。
# in-memory はインスタンスが増えるとデータが食い違い、再起動で消える。
# RECEPTION_DATASTORE=firestore
# GOOGLE_APPLICATION_CREDENTIALS_JSON=   # Vercel など GCP 外で動かすとき
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8181 # ローカルのエミュレータを使うとき
# FIRESTORE_PROJECT_ID=demo-reception

# ---------------------------------------------------------------------------
# デモデータ
# ---------------------------------------------------------------------------
# 0 にするとシードを投入しない。本番では必ず 0
RECEPTION_SEED=1

# ---------------------------------------------------------------------------
# APIキー
# ---------------------------------------------------------------------------
# ハッシュ化して保管されるため、平文が残るのはこの設定だけ。
# 本番では管理画面から発行し、この変数は使わない。
RECEPTION_DEMO_API_KEY=rk_dev_demo_tenant_key
RECEPTION_DEMO_DEVICE_KEY=rk_dev_reception_terminal_key

# ---------------------------------------------------------------------------
# 受付端末のプロビジョニング
# ---------------------------------------------------------------------------
# 実運用では端末セットアップ時にペアリングコードで払い出し、端末ローカルへ保存する。
# ここでの指定は開発用。
RECEPTION_DEVICE_API_KEY=rk_dev_reception_terminal_key
RECEPTION_TENANT_ID=ten_demo
RECEPTION_STORE_ID=sto_osaka
RECEPTION_DEVICE_ID=dev_osaka_01

# ---------------------------------------------------------------------------
# 共有URLの目隠し（デモ環境を関係者に限る）
# ---------------------------------------------------------------------------
# 未設定ならアクセス制御そのものを行わない（ローカル開発）
# RECEPTION_ACCESS_PASSWORD=
# RECEPTION_SESSION_SECRET=
# RECEPTION_ENV_LABEL=local

# ---------------------------------------------------------------------------
# 管理Webのログイン
# ---------------------------------------------------------------------------
# セッションの署名鍵。未設定のまま本番へ出すと起動を止める。
# openssl rand -base64 32 などで生成し、Secret Manager から注入する。
RECEPTION_ADMIN_SESSION_SECRET=insecure-dev-admin-secret

# 開発用のログイン。RECEPTION_SEED=0 の本番では投入されない。
# NODE_ENV=production では RECEPTION_DEMO_ADMIN_PASSWORD を明示したときだけ作る
# （ソースに書かれた既定値のままログインを作らないため）。
RECEPTION_DEMO_ADMIN_EMAIL=admin@example.com
RECEPTION_DEMO_ADMIN_PASSWORD=reception-dev

# ---------------------------------------------------------------------------
# 初期管理者（本番の初回起動時だけ）
# ---------------------------------------------------------------------------
# 管理ユーザーが1人もいないときだけ TenantAdmin を作る。
# ログインできたら必ず環境変数から外すこと。
# RECEPTION_BOOTSTRAP_ADMIN_EMAIL=
# RECEPTION_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 招待リンク
# ---------------------------------------------------------------------------
# 招待・再設定リンクの土台となるURL。未設定だとリクエストの Host から組み立てる。
# Host は外から書き換えられるため、本番では必ず設定する。
# RECEPTION_PUBLIC_URL=https://reception.example.com

# ---------------------------------------------------------------------------
# ネイティブアプリ（Capacitor）
# ---------------------------------------------------------------------------
# アプリがどのサーバーを見るか。cap sync 時に必要。https:// 必須。
# RECEPTION_APP_SERVER_URL=https://reception-demo.example.com
