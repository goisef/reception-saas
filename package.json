{
  "name": "reception-saas",
  "version": "0.1.0",
  "private": true,
  "description": "無人受付・来店管理SaaS — 店舗の来店体験OS",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "docker:build": "docker build -t reception-saas:local .",
    "docker:run": "docker run --rm -p 8080:8080 -e PORT=8080 reception-saas:local",
    "password:show": "bash scripts/access-control.sh show",
    "password:set": "bash scripts/access-control.sh set",
    "demo:offline": "bash scripts/access-control.sh offline",
    "demo:online": "bash scripts/access-control.sh online",
    "emulator": "firebase emulators:start --only firestore --project demo-reception",
    "test:firestore": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8181 vitest run",
    "dev:firestore": "RECEPTION_DATASTORE=firestore FIRESTORE_EMULATOR_HOST=127.0.0.1:8181 FIRESTORE_PROJECT_ID=demo-reception next dev",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleRelease",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@google-cloud/firestore": "^9.0.0",
    "next": "^16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "firebase-tools": "^15.27.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
